# Porta HTTP local (NUNCA exponha direto na internet — use Nginx/Caddy com HTTPS)
PORT=3000

# Token do endpoint. Gere com: openssl rand -hex 32
BOT_AUTH_TOKEN=troque-por-um-token-forte

# Diretório onde a sessão logada do WhatsApp Web fica salva
CHROME_PROFILE_DIR=./.chrome-profile

# false na primeira execução (para escanear o QR Code), true depois
HEADLESS=true

# Caminho do binário do Chrome (opcional; só se não estiver no PATH padrão)
# CHROME_BINARY=/usr/bin/google-chrome

# Timeouts (ms)
READY_TIMEOUT_MS=120000
SEND_TIMEOUT_MS=60000
